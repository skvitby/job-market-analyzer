# Ключ Anthropic API (US-03, US-04, US-05). Реальный ключ храните только в файле .env
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ключи альтернативных LLM-провайдеров (AC 1.5, ADR-001) — нужны, только если провайдер выбран
# в llm_providers в profile/preferences.json. Для локальной Ollama ключ не нужен.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# User-Agent для запросов к HH API: "AppName/1.0 (your_email@example.com)"
HH_USER_AGENT=job-market-analyzer/0.1 (your_email@example.com)

# Приложение HH (dev.hh.ru): Client ID и Client Secret выдаются после одобрения заявки
HH_CLIENT_ID=your_hh_client_id_here
HH_CLIENT_SECRET=your_hh_client_secret_here
# Токен приложения: получается по Client ID/Secret (grant_type=client_credentials), бессрочный
HH_APP_TOKEN=
# Путь к curl для запросов к HH (если curl исключён из VPN по приложению). Пусто — curl из PATH
HH_CURL_PATH=
